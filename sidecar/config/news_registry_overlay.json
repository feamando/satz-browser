{
  "_note": "Local Satz News overlay extending ../sgs/config/planck3/source_registry.json without modifying ../sgs. Adds wire syndication family collapse patterns and curated RSS/Atom starter feeds.",
  "wire_markers": {
    "ap": {
      "family": "wire:ap",
      "domains": ["apnews.com"],
      "patterns": ["associated press", "(ap) —", "(ap) -", "ap photo/", "copyright associated press"]
    },
    "reuters": {
      "family": "wire:reuters",
      "domains": ["reuters.com"],
      "patterns": ["reuters staff", "(reuters) -", "reporting by ", "editing by ", "thomson reuters"]
    },
    "afp": {
      "family": "wire:afp",
      "domains": ["afp.com"],
      "patterns": ["agence france-presse", "(afp)", "afp/", "afp news"]
    },
    "dpa": {
      "family": "wire:dpa",
      "domains": ["dpa.com"],
      "patterns": ["deutsche presse-agentur", "(dpa)", "dpa/"]
    },
    "dw": {
      "family": "dw",
      "domains": ["dw.com"],
      "patterns": ["deutsche welle"]
    }
  },
  "starter_feeds": [
    {
      "feed_id": "feed-dw-en",
      "domain": "dw.com",
      "feed_url": "https://rss.dw.com/xml/rss-en-all",
      "title": "DW (English)",
      "category": "independent",
      "language": "en",
      "default_enabled": true
    },
    {
      "feed_id": "feed-tagesschau-de",
      "domain": "tagesschau.de",
      "feed_url": "https://www.tagesschau.de/infoservices/alle-meldungen-100~rss2.xml",
      "title": "ARD Tagesschau",
      "category": "independent",
      "language": "de",
      "default_enabled": true
    },
    {
      "feed_id": "feed-meduza-en",
      "domain": "meduza.io",
      "feed_url": "https://meduza.io/rss/en/all",
      "title": "Meduza (English)",
      "category": "independent",
      "language": "en",
      "default_enabled": false
    },
    {
      "feed_id": "feed-kyivindep-en",
      "domain": "kyivindependent.com",
      "feed_url": "https://kyivindependent.com/feed/",
      "title": "Kyiv Independent",
      "category": "independent",
      "language": "en",
      "default_enabled": false
    },
    {
