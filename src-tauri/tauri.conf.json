{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "satz",
  "version": "0.5.2",
  "identifier": "com.satz.browser",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "satz",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERDMyMDNCMEM4OTZEQTQKUldTa2JZa01PeURUL1ZNUkIxNURqTDNwZ1RqZkdpVHplRUEycFBuYXkwd0JRb3RyckdNdUpMbmcK",
      "endpoints": [
        "https://github.com/feamando/satz-browser/releases/latest/download/latest.json"
      ]
    }
  }
}
