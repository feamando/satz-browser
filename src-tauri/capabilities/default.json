{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Satz Browser main UI webview only (child site webviews have no IPC)",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default"
  ]
}
